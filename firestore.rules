rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validWord() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'word', 'meaning', 'emoji', 'categoryId',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.word is string
        && data.word.size() > 0
        && data.word.size() <= 60
        && data.meaning is string
        && data.meaning.size() <= 120
        && data.emoji is string
        && data.emoji.size() <= 8
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.categoryId.size() <= 100
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('updatedBy' in data) || data.updatedBy == request.auth.uid);
    }

    function validCategory() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'emoji', 'base', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 30
        && data.emoji is string
        && data.emoji.size() <= 8
        && (!('base' in data) || data.base is bool)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('updatedBy' in data) || data.updatedBy == request.auth.uid);
    }

    function validDailyMission(mission) {
      return mission is map
        && mission.keys().hasOnly([
          'date', 'cardViews', 'gameCorrect', 'writingAttempts', 'rewarded'
        ])
        && mission.date is string
        && mission.date.size() == 10
        && mission.cardViews is number && mission.cardViews >= 0 && mission.cardViews <= 5
        && mission.gameCorrect is number && mission.gameCorrect >= 0 && mission.gameCorrect <= 5
        && mission.writingAttempts is number && mission.writingAttempts >= 0 && mission.writingAttempts <= 3
        && mission.rewarded is bool;
    }

    function validPetCare(care) {
      return care is map
        && care.keys().hasOnly(['xp', 'mood', 'hunger', 'foods'])
        && care.xp is number && care.xp >= 0 && care.xp <= 100000000
        && care.mood is number && care.mood >= 0 && care.mood <= 100
        && care.hunger is number && care.hunger >= 0 && care.hunger <= 100
        && care.foods is map
        && care.foods.size() <= 50;
    }

    function rewardClaimAdminUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardClaims', 'updatedAt']);
    }

    function validPlayer() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'score', 'coin', 'xp', 'combo', 'bestCombo',
          'sound', 'knownCards', 'progress', 'dailyMission',
          'ownedItems', 'equippedItem', 'ownedThemes', 'equippedTheme',
          'ownedPets', 'equippedPet', 'petCare', 'rewardClaims',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 20
        && data.score is number && data.score >= 0 && data.score <= 100000000
        && data.coin is number && data.coin >= 0 && data.coin <= 100000000
        && data.xp is number && data.xp >= 0 && data.xp <= 100000000
        && data.combo is number && data.combo >= 0 && data.combo <= 1000000
        && data.bestCombo is number && data.bestCombo >= 0 && data.bestCombo <= 1000000
        && (!('sound' in data) || data.sound is bool)
        && data.knownCards is map
        && data.knownCards.size() <= 5000
        && (!('progress' in data) || data.progress is map)
        && (!('dailyMission' in data) || validDailyMission(data.dailyMission))
        && (!('ownedItems' in data) || (data.ownedItems is map && data.ownedItems.size() <= 100))
        && (!('equippedItem' in data) || (data.equippedItem is string && data.equippedItem.size() <= 80))
        && (!('ownedThemes' in data) || (data.ownedThemes is map && data.ownedThemes.size() <= 100))
        && (!('equippedTheme' in data) || (data.equippedTheme is string && data.equippedTheme.size() <= 80))
        && (!('ownedPets' in data) || (data.ownedPets is map && data.ownedPets.size() <= 100))
        && (!('equippedPet' in data) || (data.equippedPet is string && data.equippedPet.size() <= 80))
        && (!('petCare' in data) || validPetCare(data.petCare))
        && (!('rewardClaims' in data) || (data.rewardClaims is list && data.rewardClaims.size() <= 200))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /classes/{classId} {
      allow read: if signedIn();

      match /words/{wordId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && validWord();
        allow delete: if signedIn();
      }

      match /categories/{catId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && validCategory();
        allow delete: if signedIn();
      }

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid && validPlayer();
        allow update: if signedIn()
          && validPlayer()
          && (request.auth.uid == uid || rewardClaimAdminUpdate());
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
